# AI Retail Data & Conversational Intelligence Workbench
# Environment Configuration

# LLM Provider Options: "hybrid" (default, LLM with rule fallback), "rule" (100% offline), or "gemini"
LLM_PROVIDER=hybrid

# Optional Google Gemini API Key.
# If omitted or offline, the workbench seamlessly uses its deterministic rule-based query planner and normalizer.
# Evaluation runs 100% without any paid service or API key.
GEMINI_API_KEY=

# Gemini Model name
GEMINI_MODEL=gemini-2.5-flash

# Processing & Security Limits
MAX_UPLOAD_BYTES=52428800
MAX_QUERY_LIMIT=100
DEFAULT_QUERY_LIMIT=10
QUERY_TIMEOUT_SECONDS=15
